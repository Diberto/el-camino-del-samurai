# ==========================================================================
# EL CAMINO DEL SAMURÁI - APACHE CONFIGURATION (.htaccess)
# ==========================================================================

# 0. Índice por defecto y Keep-Alive
DirectoryIndex index.php index.html
<IfModule mod_headers.c>
    Header set Connection "keep-alive"
</IfModule>

# 1. Reescribir URLs amigables
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Evitar reescritura para archivos y directorios reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Reescribir /blog/mi-articulo -> blog.php?slug=mi-articulo
    RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog.php?slug=$1 [L,QSA]
</IfModule>

# 2. Compresión Ultra Rápida: Brotli preferente con fallback a Gzip
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 3. Políticas de Caché Agresivas en Navegador (HTTP Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Cabeceras Cache-Control explícitas e inmutabilidad para recursos estáticos
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# 4. Encabezados de Seguridad
<IfModule mod_headers.c>
    # Prevenir MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Prevenir clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    # XSS Protection legacy (IE/Edge antiguos)
    Header always set X-XSS-Protection "1; mode=block"
    # HSTS: forzar HTTPS por 1 año (activar sólo si el sitio tiene SSL estable)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Referrer: enviar sólo origen en cross-origin
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Deshabilitar APIs sensibles no utilizadas
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.quilljs.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.quilljs.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.quilljs.com https://cdn.jsdelivr.net; img-src 'self' data: https:; connect-src 'self' https://cdn.quilljs.com https://cdn.jsdelivr.net; frame-ancestors 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# 5. Bloquear acceso web directo a archivos JSON de datos
<FilesMatch "\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Bloquear acceso a archivos de configuración y sensibles
<FilesMatch "\.(env|log|bak|sql|sh|git)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 7. Deshabilitar listado de directorios
Options -Indexes
