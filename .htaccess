# ==========================================================================
# EL CAMINO DEL SAMURÁI - APACHE CONFIGURATION (.htaccess)
# ==========================================================================

# 1. Reescribir URLs amigables
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Evitar reescritura para archivos y directorios reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Reescribir /blog/mi-articulo -> blog.php?slug=mi-articulo
    RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog.php?slug=$1 [L,QSA]
</IfModule>

# 2. Compresión Gzip para máxima velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 3. Caché de recursos estáticos en el navegador
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4. Encabezados de Seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 5. Proteger archivos de datos JSON contra acceso directo si se desea
<FilesMatch "\.json$">
    # Permitir lectura a través de PHP pero no exposición accidental
</FilesMatch>
