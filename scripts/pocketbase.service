[Unit]
Description=PocketBase Service for El Camino del Samurai
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/el-camino-del-samurai
ExecStart=/var/www/el-camino-del-samurai/bin/pocketbase/pocketbase serve --http=127.0.0.1:8090
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
